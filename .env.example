# Salin ke variabel lingkungan Vercel (Project Settings > Environment Variables).
# Jangan pernah mengisi berkas ini dengan kunci asli dan jangan meng-commit .env.
DEEPSEEK_API_KEY=
# Kunci Gemini API (Google AI Studio, free tier) untuk pertanyaan simple.
GEMINI_API_KEY=
